# Database
DATABASE_URL="postgresql://postgres:password@localhost:6543/plotweaver"
POSTGRES_PORT=6543
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=plotweaver

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Provider API key encryption (AES-256-GCM).
# Falls back to JWT_SECRET when unset; the app refuses to start without one of
# them. Changing this value makes already-stored provider keys unreadable —
# affected users must re-enter their key in Settings.
MODEL_ENCRYPTION_KEY="change-me-32-char-minimum-secret"

# Local Ollama AI
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
FRONTEND_URL="http://localhost:5173"

# CORS — comma-separated browser origins. Falls back to FRONTEND_URL; never "*".
CORS_ORIGIN="http://localhost:5173"

# Admin access — comma-separated emails allowed to call the /users endpoints.
# Empty means nobody is an admin. Checked by AdminGuard on every request.
ADMIN_EMAILS=""

# App
PORT=3000

# Local character images; set an absolute path when running from an npm package.
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5
