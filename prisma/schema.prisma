// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─────────────────────────────────────────────────────────────────────────────
// Reserved, NOT yet wired. `Profile`, `Role`, `UserRole`, `Comment`, `Review`,
// `Follow`, `Bookmark`, `MediaAsset` and the `CommentTargetType` / `MediaType` /
// `RoleName` enums have zero references in `src/` — verified 2026-09-26. They are
// kept deliberately as the shape of planned features (following, commenting,
// bookmarking, reviews, media). Admin access is gated by the `ADMIN_EMAILS`
// allowlist in `src/auth/guards/admin.guard.ts`, NOT by `Role`/`UserRole`.
// Do not drop them without a product decision; do not assume they are live.
// ─────────────────────────────────────────────────────────────────────────────

enum NovelStatus {
  draft
  unpublished
  published
}

enum CommentTargetType {
  novel
  episode
}

enum MediaType {
  cover
  illustration
}

enum RoleName {
  admin
  writer
  reader
}


enum GenerationStatus {
  pending
  queued
  processing
  completed
  failed
  canceled
}


model User {
  id        String      @id @default(uuid())
  email     String      @unique
  name      String?
  password  String?
  googleId  String?     @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  /// Every token issued before this instant is rejected. Bumped by POST /auth/logout-all.
  tokensValidFrom DateTime?

  profile   Profile?
  roles     UserRole[]
  novels    Novel[]
  comments  Comment[]
  reviews   Review[]
  follows   Follow[]
  bookmarks Bookmark[]
  media     MediaAsset[]
  modelConfigs UserModelConfig[]
}

model Profile {
  id          String   @id @default(uuid())
  displayName String?
  avatarUrl   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
}

model Role {
  id        String   @id @default(uuid())
  name      RoleName @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     UserRole[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Novel {
  id          String      @id @default(uuid())
  title       String
  summary     String?     @db.Text
  status      NovelStatus @default(draft)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  episodes    Episode[]
  reviews     Review[]
  follows     Follow[]
  tags        NovelTag[]
  media       MediaAsset[]
  generations StoryGenerationRequest[]
  chunks      EpisodeChunk[]
  context     NovelContext?
}

model Episode {
  id          String   @id @default(uuid())
  novelId     String
  title       String
  content        String   @db.Text
  episodeSummary String?  @db.Text
  order          Int
  isPublished Boolean  @default(false)
  cast        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  novel              Novel                   @relation(fields: [novelId], references: [id])
  bookmarks          Bookmark[]
  chunks             EpisodeChunk[]
  /// Generation requests that used this episode as their source/seed content
  generationRequests StoryGenerationRequest[]
  conversationMessages ConversationMessage[]

  @@unique([novelId, order])
}

model Comment {
  id         String            @id @default(uuid())
  userId     String
  targetType CommentTargetType
  targetId   String
  content    String            @db.Text
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  novelId   String
  userId    String
  rating    Int
  content   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel     Novel    @relation(fields: [novelId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([novelId, userId])
}

model Follow {
  id        String   @id @default(uuid())
  userId    String
  novelId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  novel     Novel    @relation(fields: [novelId], references: [id])

  @@unique([userId, novelId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  episodeId String
  position  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  episode   Episode  @relation(fields: [episodeId], references: [id])

  @@unique([userId, episodeId])
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novels    NovelTag[]
}

model NovelTag {
  id        String   @id @default(uuid())
  novelId   String
  tagId     String
  createdAt DateTime @default(now())

  novel     Novel    @relation(fields: [novelId], references: [id])
  tag       Tag      @relation(fields: [tagId], references: [id])

  @@unique([novelId, tagId])
}

model MediaAsset {
  id        String   @id @default(uuid())
  ownerId   String
  novelId   String?
  type      MediaType
  url       String
  createdAt DateTime @default(now())

  owner     User     @relation(fields: [ownerId], references: [id])
  novel     Novel?   @relation(fields: [novelId], references: [id])
}

model StoryGenerationRequest {
  id              String            @id @default(uuid())
  novelId         String?
  /// The uploaded episode whose content was used as the seed/context for this generation
  sourceEpisodeId String?
  prompt          String            @db.Text
  status          GenerationStatus  @default(pending)
  provider        String
  model           String?
  temperature     Float?
  maxTokens       Int?
  output          String?           @db.Text
  error           String?           @db.Text
  externalJobId   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  novel         Novel?   @relation(fields: [novelId], references: [id])
  sourceEpisode Episode? @relation(fields: [sourceEpisodeId], references: [id])

  @@index([status, createdAt])
  @@index([sourceEpisodeId])
}

/// RAG: 犹犧≒ｹ・ｸ・chunks 犧もｸｭ犧・ｹ≒ｸ歩ｹ謂ｸ･犧ｰ episode 犧樅ｸ｣犹霞ｸｭ犧｡ vector embedding 犧ｪ犧ｳ犧ｫ犧｣犧ｱ犧・semantic search
model EpisodeChunk {
  id         String                       @id @default(uuid())
  episodeId  String
  novelId    String
  chunkIndex Int
  content    String                       @db.Text
  /// Gemini text-embedding-004 produces 768-dimensional vectors
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                     @default(now())

  episode    Episode                      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  novel      Novel                        @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
  @@index([episodeId])
}

/// 犧壟ｸｱ犧吭ｸ伶ｸｶ犧・context 犧もｸｭ犧・ｸ吭ｸｴ犧｢犧ｲ犧｢犧ｪ犧ｳ犧ｫ犧｣犧ｱ犧壟ｹ・ｸ癌ｹ霞ｹ犧巵ｹ・ｸ・system prompt 犧もｸｭ犧・AI
model NovelContext {
  id            String   @id @default(uuid())
  novelId       String   @unique
  /// JSON array: [{ name, description, role }]
  characters    String?  @db.Text
  /// JSON: { setting, time, locations }
  worldBuilding String?  @db.Text
  /// 犹もｸ・ｸ｣犧・ｹ犧｣犧ｷ犹謂ｸｭ犧・ｸｫ犧･犧ｱ犧・/ outline
  plotOutline   String?  @db.Text
  /// 犧・ｸｳ犧ｭ犧倨ｸｴ犧壟ｸｲ犧｢ style 犧≒ｸｲ犧｣犹犧もｸｵ犧｢犧・犹犧癌ｹ謂ｸ・"犧壟ｸ｣犧｣犧｢犧ｲ犧｢犧･犧ｰ犹犧ｭ犧ｵ犧｢犧・ 犧壟ｸ伶ｸｪ犧吭ｸ伶ｸ吭ｸｲ犧ｪ犧ｱ犹霞ｸ・
  writingStyle  String?  @db.Text
  updatedAt     DateTime @updatedAt

  novel         Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

/// Stores per-episode AI conversation history for multi-device persistence
model ConversationMessage {
  id        String   @id @default(cuid())
  episodeId String
  role      String   // 'user' | 'assistant'
  content   String   @db.Text
  status    String   @default("done")
  createdAt DateTime @default(now())

  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, createdAt])
}

enum ModelProvider {
  openai
  anthropic
  google
  mistral
  ollama
  custom
}

model UserModelConfig {
  id        String        @id @default(uuid())
  userId    String
  label     String
  provider  ModelProvider
  modelName String
  apiKey    String?       @db.Text
  baseUrl   String?
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

